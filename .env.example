# ──────────────────────────────────────────────────────────────
# Take2 — environment variables
# Copy to .env (local dev) or paste into Vercel → Settings →
# Environment Variables (production).
# ──────────────────────────────────────────────────────────────

# Postgres connection string (Neon).
# ⚠ Do NOT add channel_binding=require — Prisma's URL parser does not
#   support that parameter (P1012). sslmode=require is sufficient; TLS
#   is always on with Neon regardless.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# NextAuth — secret must be a long random string (openssl rand -base64 32).
NEXTAUTH_SECRET="change-me-openssl-rand-base64-32"
# Canonical app URL in production (no trailing slash).
NEXTAUTH_URL="https://your-app.example.com"

# Optional: base URL baked into printed/dynamic QR codes (scan short links
# /t/<token>). If unset, falls back to the request's public host.
NEXT_PUBLIC_APP_URL=""

# Optional (default off): show the demo-accounts card (roles + shared
# password) on the landing page. Dev/demo convenience only — NEVER enable in
# production. Build-time inlined: change requires a rebuild/redeploy.
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS="false"

# Optional — realtime socket gateway.
# Local default: the Next.js server publishes to http://localhost:3003 and
# browsers connect to the same origin (?XTransformPort=3003, proxied by Caddy).
# If you host the realtime mini-service elsewhere, set:
#   REALTIME_URL="wss://realtime.example.com"            (server → gateway)
#   NEXT_PUBLIC_REALTIME_URL="wss://realtime.example.com" (browser → gateway)

# Realtime mini-service (mini-services/realtime-service) binds to a
# hard-coded port 3003 — run it behind Caddy/nginx or map the platform port.
