// QR-Based Restaurant Quick Order System — Prisma Schema
// Multi-tenant SaaS platform with RBAC, real-time orders, payments, billing, reports

generator client {
  provider = "prisma-client-js"
}







datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTH & USERS & RBAC
// ============================================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  phone         String?
  avatar        String?
  // Role: SUPER_ADMIN | RESTAURANT_OWNER | MANAGER | KITCHEN_STAFF | WAITER | CASHIER
  role          String   @default("WAITER")
  active        Boolean  @default(true)
  // Tenant isolation: a super admin has no restaurantId; everyone else is scoped
  restaurantId  String?
  branchId      String?

  restaurant    Restaurant? @relation("RestaurantStaff", fields: [restaurantId], references: [id], onDelete: Cascade)
  branch        Branch?     @relation("BranchStaff",   fields: [branchId],   references: [id], onDelete: Cascade)

  ordersHandled  Order[]    @relation("AcceptedOrders")
  servedOrders   Order[]    @relation("ServedOrders")
  paymentsProcessed Payment[]
  auditLogs      AuditLog[]
  handledServiceRequests ServiceRequest[]
  sessions       Session[]
  accounts       Account[]
  invitationsSent TenantInvitation[] @relation("InvitationsSent")
  invitationsAccepted TenantInvitation[] @relation("InvitationsAccepted")
  onboardedRestaurants Restaurant[] @relation("OnboardedBy")
  verifiedPlatformFeePayments PlatformFeePayment[] @relation("PlatformFeePaymentVerifiedBy")
  platformFeeConfigUpdates PlatformFeeConfig[] @relation("PlatformFeeConfigUpdatedBy")
  rbacPermissions RolePermission[]
  rbacModuleAccess RoleModuleAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([branchId])
  @@index([role])
}

// ============================================================================
// GRANULAR RBAC — managed by SUPER_ADMIN
// ============================================================================
// RolePermission: per-role CRUD action permissions on resources (molecular level)
//   e.g. { role: MANAGER, resource: MENU_ITEM, action: CREATE, allowed: true }
// If no row exists for a (role, resource, action) tuple, the system falls back
// to the static PERMISSIONS map in src/lib/auth.ts. Once a row exists, it
// overrides the static default (allow OR deny).
model RolePermission {
  id          String   @id @default(cuid())
  role        String   // SUPER_ADMIN | RESTAURANT_OWNER | MANAGER | KITCHEN_STAFF | WAITER | CASHIER
  resource    String   // e.g. MENU_ITEM, ORDER, TABLE, STAFF, REPORTS, SETTINGS, BILLING, PLATFORM, etc.
  action      String   // CREATE | READ | UPDATE | DELETE (CRUD) or custom (VIEW, MANAGE, VERIFY, etc.)
  allowed     Boolean  @default(true)
  updatedBy   String?
  updatedByUser User?  @relation(fields: [updatedBy], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([role, resource, action])
  @@index([role])
  @@index([resource])
}

// RoleModuleAccess: controls which sidebar modules each role can see.
//   e.g. { role: MANAGER, moduleKey: 'menu', visible: true }
// If no row exists for a (role, moduleKey) tuple, the system falls back to the
// static PERMISSIONS-based check in src/components/sidebar.tsx. Once a row
// exists, it overrides (visible OR hidden).
model RoleModuleAccess {
  id          String   @id @default(cuid())
  role        String   // SUPER_ADMIN | RESTAURANT_OWNER | MANAGER | KITCHEN_STAFF | WAITER | CASHIER
  moduleKey   String   // e.g. dashboard, orders, menu, modifiers, tables, kitchen, waiter, billing, reports, staff, settings
  visible     Boolean  @default(true)
  updatedBy   String?
  updatedByUser User?  @relation(fields: [updatedBy], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([role, moduleKey])
  @@index([role])
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// MULTI-TENANT RESTAURANT MODEL
// ============================================================================

model Restaurant {
  id              String   @id @default(cuid())
  slug            String   @unique   // URL slug used in QR codes
  name            String
  logo            String?
  tagline         String?
  description     String?
  address         String
  city            String?
  state           String?
  postalCode      String?
  phone           String
  email           String?
  website         String?

  // Tax & billing
  gstNumber       String?
  panNumber       String?
  currency        String   @default("INR")
  currencySymbol  String   @default("₹")
  taxRate         Float    @default(0.05)   // 5% GST default
  serviceChargeRate Float  @default(0.00)   // optional service charge

  // Hours
  openingTime     String   @default("09:00")
  closingTime     String   @default("23:00")
  isOpen          Boolean  @default(true)

  // Payment methods accepted
  acceptUpi       Boolean  @default(true)
  acceptCard      Boolean  @default(true)
  acceptCash      Boolean  @default(true)
  acceptCounter   Boolean  @default(true)

  // UPI ID for receiving payments (e.g. restaurant@okhdfcbank)
  // Used to generate UPI deep links + QR codes for customer payments
  upiId           String?

  // Theme
  primaryColor    String   @default("#EA580C")   // warm orange (food-friendly)
  accentColor     String   @default("#16A34A")    // green for veg indicators

  // Subscription / plan (legacy fields kept for backward compat; canonical source = Subscription model)
  plan            String   @default("TRIAL")    // TRIAL | STARTER | PRO | ENTERPRISE
  subscriptionStatus String @default("ACTIVE")
  trialEndsAt     DateTime?
  suspendedAt     DateTime?
  suspendedReason String?
  onboardedById   String?  // super admin who created this tenant (null = self-signup)

  // Platform fee block — when true, customers cannot scan QR codes to place
  // orders. Set by the super admin when a restaurant has overdue platform
  // fees (pending for more than 30 days).
  platformFeeBlocked   Boolean  @default(false)
  platformFeeBlockedAt DateTime?
  platformFeeBlockReason String?

  users           User[]           @relation("RestaurantStaff")
  branches        Branch[]
  tables          Table[]
  menuCategories  MenuCategory[]
  menuItems       MenuItem[]
  modifierGroups  ModifierGroup[]
  orders          Order[]
  customers       Customer[]
  payments        Payment[]
  invoices        Invoice[]
  serviceRequests ServiceRequest[]
  settings        RestaurantSettings?
  auditLogs       AuditLog[]
  subscription    Subscription?
  invitations     TenantInvitation[]
  onboardedBy     User?       @relation("OnboardedBy", fields: [onboardedById], references: [id])
  platformFees    PlatformFee[]
  paymentMethods  RestaurantPaymentMethod[]
  feePayments     PlatformFeePayment[]
  feePaymentRequests PlatformFeePaymentRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// RESTAURANT PAYMENT METHODS (Zepto-style configurable payment options)
// ============================================================================
// Each row = one payment option offered by a restaurant at checkout.
// A restaurant can configure label, description, icon, accent color, priority,
// and a JSON `config` blob for provider-specific settings (e.g. UPI VPA,
// Razorpay key ID, etc.). The `type` field drives the customer-facing flow.
//
// Type values:
//   UPI         → UPI deep-link + QR fallback
//   QR          → Standalone QR (renders a QR for the configured payload)
//   CARD        → Credit / Debit card (mock provider)
//   WALLET      → Mobile wallet (PhonePe / Paytm / Mobikwik etc.)
//   NETBANKING  → Net banking redirect (mock)
//   CASH        → Pay cash to waiter / counter staff
//   COUNTER     → Pay at counter (cash or card, in person)
//   PAY_LATER   → Pay-later / Tab (post-paid, settled at end of meal)
//   CUSTOM      → Restaurant-defined flow (renders as informational card)
model RestaurantPaymentMethod {
  id            String   @id @default(cuid())
  restaurantId  String

  // Canonical type — drives the customer-facing payment flow.
  // See model comment above for the value set.
  type          String

  // Display label shown to customers (e.g. "UPI", "PhonePe", "Pay at counter")
  label         String
  // Short helper text shown under the label (e.g. "GPay / PhonePe / Paytm")
  description   String?
  // Lucide icon name (e.g. "Smartphone", "CreditCard", "Banknote", "Wallet",
  // "Building", "QrCode", "Clock"). UI falls back to a default if missing.
  icon          String?
  // Tailwind-friendly hex color used for the icon chip (e.g. "#EA580C")
  accentColor   String   @default("#64748B")

  // Whether this method is shown to customers at checkout
  active        Boolean  @default(true)
  // Sort order — lower numbers appear first in the customer picker
  priority      Int      @default(100)

  // JSON blob with provider-specific config:
  //   UPI  → { upiId: "restaurant@okhdfcbank" }
  //   CARD → { provider: "RAZORPAY" | "STRIPE" | "MOCK",KeyId?: "...", keySecret?: "..." }
  //   WALLET → { provider: "PHONEPE" | "PAYTM" | "MOBIKWIK" | "MOCK" }
  //   QR → { payload: "upi://..." | override }
  config        Json?

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([restaurantId, active])
}

model Branch {
  id            String   @id @default(cuid())
  restaurantId  String
  name          String   // e.g. "Downtown", "Airport"
  address       String
  phone         String?
  active        Boolean  @default(true)

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  users         User[]     @relation("BranchStaff")
  tables        Table[]
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

// ============================================================================
// TABLES & QR CODES
// ============================================================================

model Table {
  id            String   @id @default(cuid())
  restaurantId  String
  branchId      String?
  number        String   // Display number e.g. "T1", "5", "Patio-2"
  label         String?  // Optional friendly name
  capacity      Int      @default(4)
  active        Boolean  @default(true)
  qrCodeToken   String   @unique   // random token used in QR URL for security
  // Status: AVAILABLE | OCCUPIED | ORDERING | FOOD_PREPARING | BILL_REQUESTED | PAYMENT_PENDING | COMPLETED
  status        String   @default("AVAILABLE")

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch        Branch?    @relation(fields: [branchId],   references: [id], onDelete: SetNull)
  orders        Order[]
  serviceRequests ServiceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, number])
  @@index([restaurantId])
  @@index([status])
}

// ============================================================================
// MENU STRUCTURE (categories → items → variants & modifiers)
// ============================================================================

model MenuCategory {
  id            String   @id @default(cuid())
  restaurantId  String
  name          String   // Starters, Biryani, Main Course, Breads, Beverages, Desserts
  description   String?
  icon          String?  // emoji or icon name
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems     MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

model MenuItem {
  id            String   @id @default(cuid())
  restaurantId  String
  categoryId    String
  name          String
  description   String?
  image         String?  // URL or base64
  // Type
  isVeg         Boolean  @default(true)
  isSpicy       Boolean  @default(false)
  // Pricing
  basePrice     Float    // in INR
  taxRate       Float    @default(0.05)  // overrides restaurant default if needed
  // State
  available     Boolean  @default(true)
  soldOut       Boolean  @default(false)
  // Featured / popular
  isFeatured    Boolean  @default(false)
  isPopular     Boolean  @default(false)
  // Scheduling
  availableFrom String?  // "09:00"
  availableTo   String?  // "23:00"
  // Tags
  tags          String?  // comma-separated: "bestseller, chef-special"
  sortOrder     Int      @default(0)
  // Prep time estimate (minutes)
  prepTime      Int      @default(15)

  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category      MenuCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants      MenuVariant[]
  modifierGroups ModifierGroup[] @relation("ItemModifierGroups")
  orderItems    OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([categoryId])
  @@index([available])
  @@index([soldOut])
}

model MenuVariant {
  id            String   @id @default(cuid())
  menuItemId    String
  name          String   // Regular, Large, Half, Full
  priceModifier Float    @default(0)   // additive (e.g. +50 for Large)
  sortOrder     Int      @default(0)
  isDefault     Boolean  @default(false)

  menuItem      MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  createdAt DateTime @default(now())
  @@index([menuItemId])
}

// Modifier groups: e.g. "Add-ons", "Spice Level", "Size", "Sauces"
model ModifierGroup {
  id            String   @id @default(cuid())
  restaurantId  String
  menuItemId    String?  // null = available restaurant-wide
  name          String   // "Add-ons", "Spice Level"
  description   String?
  // Selection type: SINGLE | MULTIPLE
  selectionType String   @default("SINGLE")
  required      Boolean  @default(false)
  minSelection  Int      @default(0)
  maxSelection  Int      @default(1)
  sortOrder     Int      @default(0)

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItem      MenuItem?  @relation("ItemModifierGroups", fields: [menuItemId], references: [id], onDelete: Cascade)
  modifiers     Modifier[]

  createdAt DateTime @default(now())
  @@index([restaurantId])
  @@index([menuItemId])
}

model Modifier {
  id            String   @id @default(cuid())
  groupId       String
  name          String   // "Extra Cheese", "Medium Spicy"
  price         Float    @default(0)
  isDefault     Boolean  @default(false)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)

  group         ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]

  createdAt DateTime @default(now())
  @@index([groupId])
}

// ============================================================================
// CUSTOMERS (lightweight — no account required to order)
// ============================================================================

model Customer {
  id            String   @id @default(cuid())
  restaurantId  String
  name          String?
  phone         String?
  email         String?
  // Optional session identifier for guests
  sessionToken  String?

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([phone])
}

// ============================================================================
// ORDERS & ORDER ITEMS
// ============================================================================

model Order {
  id            String   @id @default(cuid())
  orderNumber   String   // human-friendly: SG-000001
  restaurantId  String
  branchId      String?
  tableId       String
  customerId    String?
  // Status: PENDING_PAYMENT | NEW | ACCEPTED | PREPARING | READY | SERVED | COMPLETED | CANCELLED
  // PENDING_PAYMENT = customer placed the order but hasn't paid yet (pre-payment mode).
  //   The order is hidden from the kitchen/orders module until payment is confirmed,
  //   at which point it transitions to NEW and becomes visible for acceptance.
  status        String   @default("NEW")
  // Payment status: PENDING | PROCESSING | PAID | FAILED | REFUNDED
  paymentStatus String   @default("PENDING")
  // Payment method: UPI | CARD | CASH | COUNTER | WALLET
  paymentMethod String?
  // ID of the RestaurantPaymentMethod row the customer chose at order placement.
  // Used by the post-serve payment picker to hide the same option (e.g. "Pay in cash"
  // already chosen — don't show it again). Null for legacy orders / when no method
  // was recorded at placement time.
  paymentMethodId String?

  // Special instructions from customer
  notes         String?
  // Idempotency key to prevent duplicate order submission
  idempotencyKey String? @unique

  // Customer snapshot (captured at order placement so the restaurant always
  // has the name & phone even if the Customer record is later deleted)
  customerName  String?
  customerPhone String?

  // Payment timing flags (set by restaurant owner)
  // prePaymentRequested: restaurant asks customer to pay BEFORE the order is accepted
  // postPaymentRequested: restaurant asks customer to pay AFTER the order is received (served)
  prePaymentRequested  Boolean  @default(false)
  postPaymentRequested Boolean  @default(false)
  prePaymentRequestedAt  DateTime?
  postPaymentRequestedAt DateTime?

  // Who marked a CASH payment as received (waiter / owner / manager / cashier).
  // When a cash payment is collected, the user's id + name snapshot are stored
  // so the payments report can attribute the collection to a specific person.
  cashReceivedById   String?
  cashReceivedByName String?
  cashReceivedAt     DateTime?

  // Pricing (server-validated)
  subtotal      Float    @default(0)
  taxAmount     Float    @default(0)
  serviceCharge Float    @default(0)
  discountAmount Float   @default(0)
  discountCode  String?
  refundAmount  Float    @default(0)   // amount refunded (partial or full)
  refundedAt    DateTime?
  refundReason  String?
  grandTotal    Float    @default(0)   // original grand total (pre-refund)
  netTotal      Float    @default(0)   // grandTotal - refundAmount (actual collected)

  // Platform fee snapshot (stored at order time for audit)
  platformFeeAmount Float @default(0)
  platformFeeBase   Float @default(0)   // the base the fee was calculated on
  platformFeePayer  String? // RESTAURANT | CUSTOMER | SPLIT

  // Staff who handled the order
  acceptedById  String?
  servedById    String?

  // Timing
  placedAt      DateTime @default(now())
  acceptedAt    DateTime?
  preparingAt   DateTime?
  readyAt       DateTime?
  servedAt      DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch        Branch?    @relation(fields: [branchId],   references: [id], onDelete: SetNull)
  table         Table      @relation(fields: [tableId],    references: [id], onDelete: Cascade)
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  acceptedBy    User?      @relation("AcceptedOrders", fields: [acceptedById], references: [id])
  servedBy      User?      @relation("ServedOrders",   fields: [servedById],   references: [id])
  items         OrderItem[]
  payments      Payment[]
  invoices      Invoice[]
  serviceRequests ServiceRequest[]
  platformFee   PlatformFee?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([tableId])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  menuItemId    String
  menuItemName  String   // snapshot at order time
  menuItemImage String?
  variantId     String?
  variantName   String?
  quantity      Int      @default(1)
  // Pricing per unit (server-validated)
  basePrice     Float
  variantPrice  Float    @default(0)
  modifiersTotal Float   @default(0)
  unitPrice     Float    // basePrice + variantPrice + modifiersTotal
  totalPrice    Float    // unitPrice * quantity
  // Snapshot
  isVeg         Boolean
  notes         String?  // per-item notes

  order         Order    @relation(fields: [orderId],     references: [id], onDelete: Cascade)
  menuItem      MenuItem @relation(fields: [menuItemId],  references: [id])
  variant       MenuVariant? @relation(fields: [variantId], references: [id])
  modifiers     OrderItemModifier[]

  createdAt DateTime @default(now())
  @@index([orderId])
  @@index([menuItemId])
}

model OrderItemModifier {
  id            String   @id @default(cuid())
  orderItemId   String
  modifierId    String
  modifierName  String
  groupName     String
  price         Float    @default(0)

  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier      Modifier  @relation(fields: [modifierId], references: [id])

  @@index([orderItemId])
}

// ============================================================================
// PAYMENTS & INVOICES
// ============================================================================

model Payment {
  id            String   @id @default(cuid())
  orderId       String
  restaurantId  String
  // Method: UPI | CARD | CASH | COUNTER | WALLET
  method        String
  // Status: PENDING | PROCESSING | PAID | FAILED | REFUNDED
  status        String   @default("PENDING")
  amount        Float
  currency      String   @default("INR")
  // Provider reference (for online payments)
  provider      String?  // RAZORPAY | PHONEPE | PAYTM | STRIPE | CASH | COUNTER
  providerTxnId String?
  providerRef   String?
  // Idempotency
  idempotencyKey String? @unique
  // Verification
  verifiedAt    DateTime?
  verifiedById  String?
  failureReason String?

  // Metadata
  rawResponse   String?

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  verifiedBy    User?    @relation(fields: [verifiedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([restaurantId])
  @@index([status])
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique  // SG-INV-000001
  orderId       String
  restaurantId  String
  // Snapshot of restaurant details at billing time
  restaurantName String
  restaurantAddress String
  restaurantGst  String?
  restaurantPhone String
  // Snapshot of order
  tableNumber   String
  orderNumber   String
  // Totals
  subtotal      Float
  taxAmount     Float
  serviceCharge Float
  discountAmount Float
  grandTotal    Float
  // Payment
  paymentMethod String?
  paymentStatus String
  // Customer
  customerName  String?
  customerPhone String?

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  issuedAt DateTime @default(now())
  @@index([orderId])
  @@index([restaurantId])
}

// ============================================================================
// SERVICE REQUESTS (call waiter, request bill)
// ============================================================================

model ServiceRequest {
  id            String   @id @default(cuid())
  restaurantId  String
  tableId       String
  orderId       String?
  // Type: CALL_WAITER | REQUEST_BILL | WATER | CLEANUP | CUSTOM
  type          String
  status        String   @default("PENDING")  // PENDING | ACKNOWLEDGED | COMPLETED
  notes         String?
  handledById   String?

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table         Table      @relation(fields: [tableId], references: [id])
  order         Order?     @relation(fields: [orderId], references: [id])
  handledBy     User?      @relation(fields: [handledById], references: [id])

  createdAt DateTime @default(now())
  resolvedAt DateTime?

  @@index([restaurantId, status])
  @@index([tableId])
}

// ============================================================================
// NOTIFICATIONS & AUDIT
// ============================================================================

model Notification {
  id            String   @id @default(cuid())
  restaurantId  String
  // Target audience: KITCHEN | WAITER | CUSTOMER | ADMIN
  target        String
  // Type: NEW_ORDER | ORDER_ACCEPTED | ORDER_PREPARING | ORDER_READY | ORDER_SERVED | PAYMENT_CONFIRMED | BILL_READY | SERVICE_REQUEST
  type          String
  title         String
  message       String
  // Related entities
  orderId       String?
  tableId       String?
  // Delivery
  read          Boolean  @default(false)
  readAt        DateTime?

  createdAt DateTime @default(now())
  @@index([restaurantId, target, read])
  @@index([createdAt])
}

model RestaurantSettings {
  id            String   @id @default(cuid())
  restaurantId  String   @unique
  // Digital receipt config
  receiptHeader String?
  receiptFooter String?
  showLogoOnReceipt Boolean @default(true)
  // Notification preferences
  notifyKitchenOnNewOrder   Boolean @default(true)
  notifyWaiterOnBillRequest Boolean @default(true)
  playSoundOnNewOrder       Boolean @default(true)
  // Auto-accept orders
  autoAcceptOrders          Boolean @default(false)
  // Allow customer to call waiter
  allowCallWaiter           Boolean @default(true)
  // Allow customer to request bill
  allowRequestBill          Boolean @default(true)
  // Max items per order
  maxItemsPerOrder          Int     @default(50)
  // Tax inclusive pricing
  taxInclusive              Boolean @default(false)

  // Payment collection timing controls (managed by restaurant owner)
  // allowPrePayment:  owner can require payment BEFORE accepting the order
  // allowPostPayment: owner can require payment AFTER the order is received (served)
  allowPrePayment           Boolean @default(true)
  allowPostPayment          Boolean @default(true)
  // Default behaviour for new orders:
  // requirePrePayment:  automatically request pre-payment when a new order arrives
  // requirePostPayment: automatically request post-payment when an order is served
  requirePrePayment         Boolean @default(false)
  requirePostPayment        Boolean @default(false)

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id            String   @id @default(cuid())
  restaurantId  String?
  userId        String?
  action        String   // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | STATUS_CHANGE
  entity        String   // ORDER | MENU_ITEM | TABLE | USER | PAYMENT | etc.
  entityId      String?
  details       String?  // JSON string of changes
  ipAddress     String?
  userAgent     String?

  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  user          User?       @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  @@index([restaurantId])
  @@index([userId])
  @@index([entity, entityId])
}

// ============================================================================
// MULTI-TENANT BUSINESS MODELS (subscriptions, plans, invitations, platform)
// ============================================================================

model Subscription {
  id              String   @id @default(cuid())
  restaurantId    String   @unique
  // Plan tier: TRIAL | STARTER | PRO | ENTERPRISE
  plan            String   @default("TRIAL")
  // Status: ACTIVE | PAST_DUE | CANCELLED | SUSPENDED | TRIALING
  status          String   @default("TRIALING")
  // Billing cycle: MONTHLY | YEARLY
  billingCycle    String   @default("MONTHLY")
  // Pricing (in INR paise to avoid float; convert /100 for display)
  amount          Int      @default(0)
  currency        String   @default("INR")
  // Period
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialStartsAt     DateTime?
  trialEndsAt       DateTime?
  // Cancellation
  cancelledAt       DateTime?
  cancelReason      String?
  // Payment provider (for future expansion)
  provider          String?  // RAZORPAY | STRIPE
  providerSubId     String?
  // Auto-renew
  autoRenew         Boolean  @default(true)

  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantInvitation {
  id            String   @id @default(cuid())
  email         String
  restaurantId  String?
  // Role the invitee will get once they accept
  role          String   @default("RESTAURANT_OWNER")
  // Token for secure acceptance
  token         String   @unique
  // Status: PENDING | ACCEPTED | EXPIRED | REVOKED
  status        String   @default("PENDING")
  invitedById   String
  expiresAt     DateTime
  acceptedAt    DateTime?
  acceptedById  String?

  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  invitedBy     User        @relation("InvitationsSent", fields: [invitedById], references: [id])
  acceptedBy    User?       @relation("InvitationsAccepted", fields: [acceptedById], references: [id])

  createdAt DateTime @default(now())
  @@index([email])
  @@index([restaurantId])
  @@index([status])
}

model PlatformSettings {
  id            String   @id @default(cuid())
  // Global platform config (singleton row)
  platformName  String   @default("QR Dine")
  supportEmail  String   @default("support@qrdine.com")
  // Default trial duration (days)
  defaultTrialDays Int   @default(14)
  // Default plan when a new tenant signs up
  defaultPlan   String   @default("TRIAL")
  // Whether public signup is enabled
  publicSignupEnabled Boolean @default(true)
  // Featured plans on the pricing page
  featuredPlans String   @default("STARTER,PRO")
  // Platform commission percentage on each transaction (future)
  commissionRate Float   @default(0.0)
  // Branding
  primaryColor  String   @default("#EA580C")
  logoUrl       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// PLATFORM FEE / COMMISSION SYSTEM
// ============================================================================

model PlatformFeeConfig {
  id              String   @id @default(cuid())
  // Singleton — only one row exists
  // Fee Type: PERCENTAGE | FIXED_PER_ORDER | MONTHLY_SUBSCRIPTION | HYBRID
  feeType         String   @default("PERCENTAGE")
  // For PERCENTAGE: 0.5 means 0.5%
  // For FIXED_PER_ORDER: amount in paise (e.g. 500 = ₹5)
  // For MONTHLY_SUBSCRIPTION: monthly amount in paise
  // For HYBRID: percentage + fixed amount both apply
  percentageRate  Float    @default(0.5)   // %
  fixedAmount     Int      @default(0)     // paise
  monthlyAmount   Int      @default(0)     // paise (for monthly subscription)

  // Fee Applies To: FOOD_SUBTOTAL | DISCOUNTED_SUBTOTAL | TOTAL_EXCLUDING_TAX | TOTAL_INCLUDING_TAX
  appliesTo       String   @default("TOTAL_EXCLUDING_TAX")

  // Caps (in paise; null = no cap)
  minimumFee      Int      @default(0)     // paise
  maximumFee      Int?                     // paise; null = unlimited

  // Who Pays: RESTAURANT | CUSTOMER | SPLIT
  payer           String   @default("RESTAURANT")
  // For SPLIT mode: percentage paid by customer (rest by restaurant)
  customerSplitPct Float   @default(50)    // 0-100

  // Per-plan overrides (JSON string): { "TRIAL": {feeType, percentageRate, ...}, ... }
  // If a plan key is present, it overrides the global config for that plan
  planOverrides   String?

  // Status
  active          Boolean  @default(true)
  updatedAt       DateTime @updatedAt
  updatedById     String?

  updatedBy       User?    @relation("PlatformFeeConfigUpdatedBy", fields: [updatedById], references: [id])
}

model PlatformFee {
  id              String   @id @default(cuid())
  orderId         String   @unique
  restaurantId    String
  // Snapshot of config at time of order
  feeType         String
  percentageRate  Float    @default(0)
  fixedAmount     Int      @default(0)
  // Calculation
  baseAmount      Float    // the base the fee was calculated on (in rupees)
  grossFee        Float    // fee before min/max caps
  feeAmount       Float    // final fee after caps (in rupees)
  payer           String   // RESTAURANT | CUSTOMER | SPLIT
  customerPortion Float    @default(0)   // portion paid by customer
  restaurantPortion Float  @default(0)   // portion paid by restaurant
  // Status: PENDING | COLLECTED | REFUNDED | WAIVED
  status          String   @default("PENDING")
  collectedAt     DateTime?
  refundedAt      DateTime?
  refundReason    String?

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  coveredByPayments PlatformFeeCoveredEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// PLATFORM FEE PAYMENTS — end-to-end platform fee collection system
// ============================================================================
// When a restaurant pays its accumulated platform fees to the platform
// operator (super admin), a PlatformFeePayment row records the lump-sum
// payment. The payment covers a set of underlying PlatformFee rows (the
// per-order PENDING fees that the restaurant is settling).
//
// Lifecycle:
//   1. Super admin sends a PlatformFeePaymentRequest to a tenant with the
//      requested amount, due date, and note. Status = PENDING.
//   2. The tenant sees the request in their Settings → Platform Fees tab
//      and taps "Pay now" — they choose a payment method (UPI / Card /
//      Wallet / Net banking) and submit. A PlatformFeePayment row is
//      created with status = PROCESSING.
//   3. The platform verifies the payment (mock for UPI/CARD/etc.; real
//      gateway integration point) and the PlatformFeePayment transitions
//      to PAID. The covered PlatformFee rows are marked COLLECTED in bulk.
//   4. Realtime events fire at each step:
//        platform:feeRequested   → step 1 (admin → tenant)
//        platform:feePaymentInit → step 2 (tenant → admin)
//        platform:feePaid        → step 3 (system → both parties)
//        platform:feeCollected  → step 3 (system → both parties, per fee)
//
// Super admin can also do a "manual collect" (mark fees as collected
// without a payment) for offline settlements — status = COLLECTED_DIRECT.

model PlatformFeePayment {
  id              String   @id @default(cuid())
  restaurantId    String
  // Amount in rupees (lump sum)
  amount          Float
  // Method: UPI | QR | CARD | WALLET | NETBANKING | CASH | MANUAL
  method          String
  // Status: PENDING | PROCESSING | PAID | FAILED | REFUNDED | COLLECTED_DIRECT
  status          String   @default("PENDING")
  // Provider references (for online payments)
  provider        String?  // UPI | MOCK | RAZORPAY | PHONEPE | ...
  providerTxnId   String?
  providerRef     String?
  idempotencyKey  String?  @unique
  // Verification
  verifiedAt      DateTime?
  verifiedById    String?
  failureReason   String?

  // Links to a payment request (if the tenant is paying off a specific
  // request from the super admin). Null if this is a self-initiated payment.
  requestId       String?

  // Notes
  note            String?

  // Metadata
  rawResponse     String?

  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  verifiedBy      User?       @relation("PlatformFeePaymentVerifiedBy", fields: [verifiedById], references: [id])
  request         PlatformFeePaymentRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  coveredFees     PlatformFeeCoveredEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
}

// M-to-N join between a PlatformFeePayment and the PlatformFee rows it
// settles. Lets us reverse a payment cleanly (mark covered fees back to
// PENDING on refund) and audit which exact fees a payment covered.
model PlatformFeeCoveredEntry {
  id              String   @id @default(cuid())
  paymentId       String
  platformFeeId   String

  payment         PlatformFeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  platformFee     PlatformFee         @relation(fields: [platformFeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([paymentId, platformFeeId])
  @@index([paymentId])
  @@index([platformFeeId])
}

// A payment request the super admin sends to a tenant ("please pay ₹X by
// date Y for your outstanding platform fees"). Tenants see this in their
// Settings → Platform Fees tab with a "Pay now" action.
model PlatformFeePaymentRequest {
  id              String   @id @default(cuid())
  restaurantId    String
  // Amount in rupees
  amount          Float
  // Status: PENDING | PARTIALLY_PAID | PAID | EXPIRED | CANCELLED
  status          String   @default("PENDING")
  // Due date (when the admin expects payment; used to flag overdue)
  dueDate         DateTime?
  // Optional note from admin to tenant
  note            String?
  // When the request was sent
  sentAt          DateTime @default(now())
  // When the tenant paid it off (in full)
  paidAt          DateTime?
  // Amount paid so far (for partial payments)
  amountPaid      Float    @default(0)

  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  payments        PlatformFeePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// PLATFORM PAYMENT METHODS — the platform's own payment config
// ============================================================================
// Super admin configures how tenants should pay the platform (e.g. the
// platform's UPI ID, Razorpay key, etc.). Tenants see these as the
// available payment options when paying their platform fees.
//
// This is separate from RestaurantPaymentMethod (which is each
// restaurant's payment config for their customers).
model PlatformPaymentMethod {
  id              String   @id @default(cuid())
  // Type: UPI | QR | CARD | WALLET | NETBANKING
  type            String
  label           String
  description     String?
  icon            String?
  accentColor     String   @default("#EA580C")
  priority        Int      @default(10)
  active          Boolean  @default(true)
  // Provider-specific config blob (e.g. { upiId: "platform@okhdfcbank" } or
  // { provider: "RAZORPAY", keyId: "..." })
  config          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
